; Recrekt.dll exports:
;   jjiEVn              -- the protector gate, implemented natively by the trampoline
;   GetRecrektProtector -- returns the real protector's load base for the patch
;   LazyInitGate        -- called by the trampoline to run Themida's entry point exactly once
EXPORTS
    jjiEVn
    GetRecrektProtector
    EnsureGate
